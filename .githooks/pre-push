#!/usr/bin/env bash
# pre-push hook: strict publish enforcement via PROCESS ANCESTRY.
#
# STATIC committed hook — NOT auto-generated. It is activated for every
# clone via `git config core.hooksPath .githooks` (see publish.py
# --install-hook). publish.py does NOT rewrite this file. To change the
# hook you edit it here AND update its sha256 pin in the same commit
# (the pin is CI-verified — see TRDD-71a2239a, the immediate follow-up).
#
# Walks the hook's ancestor process tree looking for a python invocation
# of scripts/publish.py. If found, the push is allowed. Otherwise refused.
# This is intentionally NOT gated by an environment variable — env vars
# are trivially spoofed by `FOO=1 git push`. The process tree is harder,
# and this hook hardens it further: the ancestor must be a genuine python
# (or uv) interpreter actually targeting this repo's scripts/publish.py —
# a shell whose argv merely CONTAINS that string (bash -c, python -c,
# exec -a spoofing) is rejected. See find_publish_ancestor below.

set -eu

# Canonicalize a (possibly relative) path to an absolute, symlink-resolved
# form. The argv script token is resolved against the hook's cwd, which git
# sets to the top of the working tree — the same cwd from which the real
# `python scripts/publish.py` was launched. Prefer realpath; otherwise fall
# back to a portable dirname/pwd -P composition (no python dependency on the
# reject path). A non-existent path canonicalizes to empty (never matches).
canon_path() {
    _p=$1
    [ -n "${_p}" ] || { printf ''; return; }
    if command -v realpath >/dev/null 2>&1; then
        realpath "${_p}" 2>/dev/null || printf ''
        return
    fi
    # Fallback: resolve the directory with `pwd -P` (resolves symlinks) and
    # re-attach the basename. Only meaningful for an existing file.
    _d=$(dirname -- "${_p}" 2>/dev/null) || { printf ''; return; }
    _b=$(basename -- "${_p}" 2>/dev/null) || { printf ''; return; }
    ( cd "${_d}" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "${_b}" ) || printf ''
}

# Print the working directory of a live PID (the owner's OWN process — no
# privilege needed). Linux: /proc; macOS/BSD: lsof. Empty if undeterminable.
# WHY (TRDD-9CQ2X7HK): a RELATIVE script token in an ancestor's argv — the real
# `uv run python scripts/publish.py` carries the relative `scripts/publish.py` —
# MUST be resolved against the ANCESTOR's cwd, never the hook's cwd. Resolving a
# relative token against the hook's cwd (the original bug) let a FOREIGN or STALE
# `python scripts/publish.py` ancestor (a different repo's publish still live in
# the ancestry) false-match THIS repo, since the hook's cwd holds a same-named
# path — silently authorizing an ungated direct push. Resolve against the real
# ancestor cwd so a foreign publish's path differs and correctly fails to match.
ancestor_cwd() {
    _cpid=$1
    [ -n "${_cpid}" ] || { printf ''; return; }
    if [ -r "/proc/${_cpid}/cwd" ]; then
        readlink "/proc/${_cpid}/cwd" 2>/dev/null || printf ''
        return
    fi
    if command -v lsof >/dev/null 2>&1; then
        lsof -a -p "${_cpid}" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
        return
    fi
    printf ''
}

# Expected absolute target: THIS repo's scripts/publish.py. git_root via
# `git rev-parse --show-toplevel` so a spoof referring to some OTHER
# checkout's publish.py cannot satisfy the realpath equality below.
GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || printf '')
EXPECTED_PUBLISH=$(canon_path "${GIT_ROOT}/scripts/publish.py")

# Decide whether a SINGLE ancestor process is a genuine publish.py launch.
# comm  = basename of the executed binary (ps -o comm=) — the real interpreter.
# cmd   = full argv text          (ps -o command=)      — what was typed.
# Accept ONLY when (TRDD-4b298890 Layer 1):
#   (a) comm basename is python / python3 / python3.NN / uv;
#   (b) argv[0] basename is ALSO a python/uv name (defense-in-depth; a FAMILY
#       check, not argv0==comm — exact equality would brick a real `python …`
#       whose comm is `python3.12`; `exec -a` is already caught by (a) below);
#   (c) the first NON-FLAG argument after argv[0] realpaths to EXPECTED_PUBLISH;
#   (d) `-c` is rejected outright while scanning flags (defeats `python -c
#       'sys.argv=[...]'`), because the real publish is never launched via -c.
# A bash/sh/zsh/dash ancestor fails (a) even if its argv text contains
# publish.py — that closes the `bash -c 'echo python scripts/publish.py'` hole.
# TODO(TRDD-followup): Layer 2 nonce (.git/PUBLISH_NONCE freshness + UID + live
#   PID) / Layer 3 tag-log (refuse version-tag push off default branch, append
#   ancestor chain to .git/PUBLISH_REJECTIONS.log) attach here — deferred.
ancestor_is_publish() {
    _comm=$1
    _cmd=$2
    _pid=${3:-}
    # (a) interpreter basename must be in the python/uv family. NOTE: on macOS a
    # bare framework python reports comm basename `Python` (capital P, the
    # Python.app launcher binary) — verified empirically; rejecting it would
    # BRICK `python scripts/publish.py` on macOS. So accept any name whose
    # lowercase form starts with `python` (python, python3, python3.NN, Python,
    # pythonw, …) plus `uv`. bash/sh/zsh/dash do NOT start with `python`, so the
    # `bash -c '… python scripts/publish.py …'` hole stays closed. The exec -a
    # argv[0] spoof is ALSO caught here: `exec -a "python …" bash` leaves
    # comm=bash (the real binary), which fails this family check.
    _comm_lc=$(printf '%s' "${_comm}" | tr '[:upper:]' '[:lower:]')
    case "${_comm_lc}" in
        python|python[0-9]*|uv) : ;;
        *) return 1 ;;
    esac
    # No expected target resolvable (not in a git repo / publish.py missing) →
    # nothing can legitimately match; fail closed.
    [ -n "${EXPECTED_PUBLISH}" ] || return 1

    # Tokenize argv. POSIX word-splitting on the command text is exactly what we
    # want here: ps reports argv space-joined and the real publish paths contain
    # no spaces, so a quoted spoof cannot smuggle a different first token in.
    # shellcheck disable=SC2086
    set -- ${_cmd}
    [ "$#" -ge 1 ] || return 1

    # (b) argv[0] basename must ALSO be a python/uv interpreter name. This is a
    # FAMILY check, NOT `argv0 == comm`: a genuine `python scripts/publish.py`
    # legitimately has comm=python3.12 while argv[0]=python, and exact equality
    # would BRICK that real launch. `exec -a "python …" bash` is already rejected
    # by (a) (its comm stays `bash`); this is cheap defense-in-depth on argv[0].
    _argv0_lc=$(printf '%s' "$(basename -- "$1" 2>/dev/null || printf '')" | tr '[:upper:]' '[:lower:]')
    case "${_argv0_lc}" in
        python|python[0-9]*|uv) : ;;
        *) return 1 ;;
    esac
    shift  # drop argv[0]; scan the remaining args for the script target.

    # (c)/(d) find the first non-flag arg; reject `-c`; it must realpath to
    # EXPECTED_PUBLISH.
    while [ "$#" -ge 1 ]; do
        case "$1" in
            -c) return 1 ;;       # python -c — never the real publish launcher.
            --) shift; break ;;   # end-of-options; next token is positional.
            -*) shift; continue ;; # any other flag — skip it.
            *) break ;;            # first positional argument found.
        esac
    done
    [ "$#" -ge 1 ] || return 1
    _script=$1
    # (e) Resolve a RELATIVE script token against the ANCESTOR's cwd, not the
    # hook's cwd (TRDD-9CQ2X7HK). Absolute tokens need no cwd. If the ancestor's
    # cwd is undeterminable, fail closed — never guess against the hook's cwd,
    # which is exactly the foreign/stale-publish false-match this closes.
    case "${_script}" in
        /*) _cand=${_script} ;;
        *)
            _acwd=$(ancestor_cwd "${_pid}")
            [ -n "${_acwd}" ] || return 1
            _cand=${_acwd}/${_script}
            ;;
    esac
    [ "$(canon_path "${_cand}")" = "${EXPECTED_PUBLISH}" ] && return 0

    # NOTE — `uv run python scripts/publish.py` is admitted via the PYTHON frame,
    # NOT a uv-argv branch. Walking UP from the hook the ancestry is
    # hook -> git -> python -> uv, so the python frame (comm=python-family, first
    # positional realpaths to publish.py) is reached and admits BEFORE the uv
    # frame. A loose "comm==uv AND some argv token ends in publish.py" branch
    # would be spoofable — `uv run echo scripts/publish.py`, or `uv run python -c
    # '<evil>' scripts/publish.py` (where -c is the real target and publish.py is
    # a mere argv string) — because argv text is not trustworthy. So the uv frame
    # is intentionally NOT special-cased: its first positional is `run`, it fails
    # the strict check, and that is correct. Trust the python frame.
    return 1
}

# Walk up the process tree from the hook shell's PID, looking for a genuine
# python / uv invocation of THIS repo's scripts/publish.py. Max depth 15 to
# guard against pathological loops.
find_publish_ancestor() {
    pid=$1
    depth=0
    while [ -n "${pid}" ] && [ "${pid}" != "0" ] && [ "${pid}" != "1" ] && [ "${depth}" -lt 15 ]; do
        comm=$(ps -o comm= -p "${pid}" 2>/dev/null || printf '')
        cmd=$(ps -o command= -p "${pid}" 2>/dev/null || printf '')
        if [ -z "${cmd}" ]; then
            return 1
        fi
        # comm may be an absolute path (e.g. /usr/bin/python3) on some platforms —
        # reduce to its basename before the family check.
        comm_base=$(basename -- "${comm}" 2>/dev/null || printf '')
        if ancestor_is_publish "${comm_base}" "${cmd}" "${pid}"; then
            return 0
        fi
        ppid=$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -d ' ' || printf '')
        if [ -z "${ppid}" ] || [ "${ppid}" = "${pid}" ]; then
            return 1
        fi
        pid="${ppid}"
        depth=$((depth + 1))
    done
    return 1
}

if ! find_publish_ancestor "$$"; then
    printf '\n' >&2
    printf 'x git push REFUSED by pre-push hook.\n' >&2
    printf '\n' >&2
    printf '  Strict publish policy: every push to origin MUST go through\n' >&2
    printf '  scripts/publish.py so that lint, tests, and CPV --strict are\n' >&2
    printf '  re-verified immediately before the push. The hook verifies\n' >&2
    printf '  its caller via PROCESS ANCESTRY — not an env var — so there\n' >&2
    printf '  is no trivial way around it.\n' >&2
    printf '\n' >&2
    printf '  Run one of:\n' >&2
    printf '    uv run python scripts/publish.py --patch\n' >&2
    printf '    uv run python scripts/publish.py --minor\n' >&2
    printf '    uv run python scripts/publish.py --major\n' >&2
    printf '\n' >&2
    exit 1
fi

exit 0
